{
  "id": {
    "name": "lookup_member_balance",
    "version": "1.0.0",
    "target": "midwest_federal"
  },
  "title": "Look up a member's savings balance",
  "description": "Read-only capability: navigates to a member's detail page and extracts the current savings balance. Never mutates. Proves the schema supports read-only capabilities cleanly — no risky steps, side_effects empty, single typed output extracted from the DOM.",
  "input_schema": {
    "type": "object",
    "required": ["member_id"],
    "properties": {
      "member_id": { "type": "string", "example": "12345" }
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "savings_balance": {
        "type": "string",
        "description": "Balance rendered as an accounting-formatted string, e.g. '1,234.56'",
        "pattern": "^[0-9,]+\\.[0-9]{2}$"
      }
    },
    "required": ["savings_balance"]
  },
  "outcomes": [
    {
      "code": "SUCCESS",
      "terminal": true,
      "detected_by": {
        "kind": "url_pattern",
        "pattern": "^.*/member/\\d+$"
      },
      "extracts": [
        {
          "name": "savings_balance",
          "from": "text",
          "locator": {
            "primary": { "by": "label_relative", "anchor": "Savings Balance", "direction": "next_cell" },
            "fallbacks": [
              { "by": "css", "selector": "table.cls_data tr:nth-child(4) td:nth-child(2)" }
            ]
          },
          "regex": "\\$([0-9,]+\\.[0-9]{2})"
        }
      ]
    },
    {
      "code": "MEMBER_NOT_FOUND",
      "terminal": true,
      "detected_by": { "kind": "text_present", "text": "No member found" },
      "extracts": []
    },
    {
      "code": "ACCESS_DENIED",
      "terminal": true,
      "detected_by": { "kind": "text_present", "text": "Access denied for member" },
      "extracts": []
    },
    {
      "code": "VALIDATION_ERROR",
      "terminal": true,
      "detected_by": { "kind": "text_present", "text": "Invalid input for" },
      "extracts": []
    }
  ],
  "side_effects": [],
  "steps": [
    {
      "id": "s1",
      "action": "navigate",
      "url": "http://127.0.0.1:5000/",
      "risk": "safe",
      "notes": "Load initial page."
    },
    {
      "id": "s2",
      "action": "type",
      "target": {
        "primary": { "by": "label_relative", "anchor": "Member ID", "direction": "next_input" },
        "fallbacks": [
          { "by": "css", "selector": "input[name='q']" },
          { "by": "role_name", "role": "textbox" }
        ]
      },
      "value": "{{member_id}}",
      "risk": "safe",
      "notes": "Enter member ID."
    },
    {
      "id": "s3",
      "action": "click",
      "target": {
        "primary": { "by": "role_name", "role": "button", "name": "Search" },
        "fallbacks": [ { "by": "css", "selector": "input[type=submit][value='Search']" } ]
      },
      "risk": "safe",
      "notes": "Submit member lookup."
    }
  ],
  "checkpoint": {
    "kind": "url_pattern",
    "pattern": "^.*/member/\\d+$"
  },
  "recoveries": [
    {
      "name": "dismiss_session_refresh_flap",
      "trigger": { "kind": "text_present", "text": "Session refresh recommended" },
      "action": "dismiss",
      "dismiss_locator": {
        "primary": { "by": "css", "selector": "#flapModal button" },
        "fallbacks": []
      },
      "wait_ms": 0,
      "max_attempts": 2,
      "notes": "Reuse the base recovery pattern."
    }
  ],
  "approval_state": "approved",
  "approved_by": "chandan",
  "approved_at": "2026-09-08T05:35:00Z",
  "provenance": {
    "goal": "Look up the savings balance for member 12345 (read-only)",
    "model": "author-annotated@1",
    "recorded_at": "2026-09-08T05:35:00Z",
    "run_id": "authored_lookup_balance_v1",
    "target_url": "http://127.0.0.1:5000"
  }
}
